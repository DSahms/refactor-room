# Copy to .env and replace with your keys.
# Never commit .env — it is listed as a Flutter asset in pubspec.yaml.
#
# LLM_BACKEND=venice   (default — beta)
# LLM_BACKEND=groq
# LLM_BACKEND=anthropic
LLM_BACKEND=venice
VENICE_API_KEY=your_venice_key_here
GROQ_API_KEY=your_groq_key_here
ANTHROPIC_API_KEY=your_api_key_here
